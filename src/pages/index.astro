  }

  :global(.jeri-popup__route:hover) {
    background: #1898ad;
  }
  :global(.jeri-marker) {
    transition: filter 0.2s ease;
  }

  :global(.jeri-marker.is-active) {
    z-index: 1000 !important;
    filter: drop-shadow(0 0 7px #71d3c2);
  }

  :global(.jeri-marker.is-active .jeri-marker__number) {
    transform: scale(1.25);
    background: #71d3c2;
    color: #142a63;
    box-shadow: 0 0 0 5px rgb(113 211 194 / 30%);
  }

  :global(.jeri-marker.is-active .jeri-marker__main) {
    transform: scale(1.2);
    box-shadow: 0 0 0 6px rgb(113 211 194 / 35%);
  }

  :global(.jeri-marker__number),
  :global(.jeri-marker__main) {
    transition:
      transform 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }
</style>

<script>
  import L from 'leaflet';

  const mapElement = document.getElementById('jeri-map');
  const popupOverlay = document.getElementById(
    'jeri-popup-overlay',
  ) as HTMLDivElement;

  let activeMarker: L.Marker | null = null;

  function clearActiveMarker() {
    activeMarker?.getElement()?.classList.remove('is-active');
    activeMarker = null;
  }

  function closeCustomPopup() {
    clearActiveMarker();

    popupOverlay.hidden = true;
    popupOverlay.innerHTML = '';
  }

  popupOverlay.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;

    if (target.closest('.jeri-popup__close')) {
      closeCustomPopup();
    }
  });

  if (mapElement && !mapElement.classList.contains('leaflet-container')) {
    const map = L.map(mapElement, {
      scrollWheelZoom: false,
    }).setView([-2.890985, -40.387364], 12);

    L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
      {
        maxZoom: 19,
        attribution: 'Tiles © Esri',
      },
    ).addTo(map);

    L.tileLayer(
      'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
      {
        maxZoom: 19,
        opacity: 0.9,
        attribution: 'Labels © Esri',
      },
    ).addTo(map);

    const places = [
      {
        name: 'Cristais de Jeri',
        lat: -2.890985,
        lng: -40.387364,
        number: null,
        description: 'Estamos aqui!',
      },
      {
        name: 'Buraco Azul',
        lat: -2.853814,
        lng: -40.405883,
        number: 1,
        distance: '4,9 km',
        image: '/images/buraco-azul.jpg',
        description:
          'Uma lagoa de águas azul-turquesa em meio à paisagem natural da região de Jericoacoara.',
      },
      {
        name: 'Lagun Beach Club',
        lat: -2.843851,
        lng: -40.412901,
        number: 2,
        distance: '6,5 km',
        image: '/images/lagun-beach.jpg',
        description:
          'Um beach club com piscina, restaurante e bar, perfeito para relaxar e curtir a praia de Jericoacoara.',
      },
      {
        name: 'Lagoa Azul',
        lat: -2.854005,
        lng: -40.431323,
        number: 3,
        distance: '7,7 km',
        image: '/images/lagoa-azul.jpg',
        description:
          'Um beach club com piscina, restaurante e bar, perfeito para relaxar e curtir a praia de Jericoacoara.',
      },
      {
        name: 'Lagoa do Paraíso',
        lat: -2.874329,
        lng: -40.456066,
        number: 4,
        distance: '8,5 km',
        image: '/images/lagoa-do-paraiso.jpg',
        description:
          'Uma das lagoas mais famosas da região, conhecida por suas águas cristalinas e redes para relaxar.',
      },
      {
        name: 'Praia do Preá',
        lat: -2.814108,
        lng: -40.412798,
        number: 5,
        distance: '10 km',
        image: '/images/praia-do-prea.jpg',
        description:
          'Um beach club com piscina, restaurante e bar, perfeito para relaxar e curtir a praia de Jericoacoara.',
      },
      {
        name: 'Aeroporto de Jeri',
        lat: -2.905497,
        lng: -40.347923,
        number: 6,
        distance: '10 min',
        image: '/images/aeroporto-de-jericoacoara.jpg',
        description:
          'Um beach club com piscina, restaurante e bar, perfeito para relaxar e curtir a praia de Jericoacoara.',
      },
      {
        name: 'Alchymist Beach Club',
        lat: -2.847392,
        lng: -40.454665,
        number: 7,
        distance: '19 km',
        image: '/images/alchymist-beach-club.jpg',
        description:
          'Um beach club sofisticado, ideal para quem busca conforto e exclusividade à beira-mar.',
      },
      {
        name: 'Pedra Furada',
        lat: -2.784594,
        lng: -40.500934,
        number: 8,
        distance: '19,5 km',
        image: '/images/pedra-furada.jpg',
        description:
          'Uma formação rochosa icônica, perfeita para fotos e apreciação da natureza.',
      },
      {
        name: 'Vila de Jeri',
        lat: -2.794798,
        lng: -40.515688,
        number: 9,
        distance: '21 km',
        image: '/images/vila-de-jericoacoara.jpg',
        description:
          'O centro da vila de Jericoacoara, com ruas de areia, lojas, restaurantes e uma atmosfera única.',
      },
    ];

    const markers: L.LatLngExpression[] = [];

    places.forEach((place) => {
      const coordinates: L.LatLngExpression = [place.lat, place.lng];

      const isMain = place.number === null;

      const customIcon = L.divIcon({
        className: 'jeri-marker',
        html: isMain
          ? '<div class="jeri-marker__main"><span></span></div>'
          : `<div class="jeri-marker__number">${place.number}</div>`,
        iconSize: isMain ? [32, 32] : [30, 30],
        iconAnchor: isMain ? [16, 16] : [15, 15],
        popupAnchor: [0, isMain ? -16 : -15],
      });

      const marker = L.marker(coordinates, {
        icon: customIcon,
      }).addTo(map);

      marker.on('click', (event) => {
        L.DomEvent.stopPropagation(event.originalEvent);
        clearActiveMarker();
        activeMarker = marker;
        marker.getElement()?.classList.add('is-active');

        // const point = map.latLngToContainerPoint(coordinates);

        const popupContent = isMain
          ? `
      <article class="jeri-popup jeri-popup-overlay-card">
        <button
          type="button"
          class="jeri-popup__close"
          aria-label="Fechar"
        >×</button>
        <div class="jeri-popup__content_main">
          <p class="jeri-description">${place.description}</p>
        </div>
      </article>
    `
          : `
      <article class="jeri-popup jeri-popup-overlay-card">
        <button
          type="button"
          class="jeri-popup__close"
          aria-label="Fechar"
        >×</button>
        <img
          class="jeri-popup__image"
          src="${place.image}"
          alt="${place.name}"
        />
        <div class="jeri-popup__content">
          <span class="jeri-popup__distance">${place.distance}</span>
          <h3 class="jeri-popup__title">${place.name}</h3>
          <p class="jeri-popup__description">${place.description}</p>
          <a
            class="jeri-popup__route"
            href="https://www.google.com/maps/dir/?api=1&origin=Cristais+de+Jeri+EcoVillage&destination=${place.lat},${place.lng}&travelmode=driving"
            target="_blank"
            rel="noopener noreferrer"
          >
            Traçar rota
          </a>
        </div>
      </article>
    `;

        popupOverlay.innerHTML = popupContent;
        popupOverlay.hidden = false;

        const popupCard = popupOverlay.firstElementChild as HTMLElement;

        const point = map.latLngToContainerPoint(coordinates);
        const mapRect = mapElement.getBoundingClientRect();
        const popupHeight = popupCard.offsetHeight;
        const viewportMargin = 16;
        const popupGap = 12;

        const spaceAbove = mapRect.top + point.y - viewportMargin;
        const spaceBelow = window.innerHeight - (mapRect.top + point.y);

        const openBelow =
          spaceAbove < popupHeight + popupGap && spaceBelow > spaceAbove;

        popupCard.style.left = `${point.x}px`;
        popupCard.style.top = openBelow
          ? `${point.y + popupGap}px`
          : `${point.y - popupGap}px`;

        popupCard.style.transform = openBelow
          ? 'translate(-50%, 0)'
          : 'translate(-50%, -100%)';
      });

      markers.push(coordinates);
    });

    map.fitBounds(L.latLngBounds(markers), {
      padding: [30, 30],
    });

    map.on('focus', () => map.scrollWheelZoom.enable());
    map.on('blur', () => map.scrollWheelZoom.disable());
    map.on('click', closeCustomPopup);
    map.on('movestart zoomstart', closeCustomPopup);
  }
</script>
<script>
  const accessForm = document.querySelector<HTMLFormElement>('#access-form');
  const accessScreen = document.querySelector<HTMLDivElement>('#access-screen');
  const accessError =
    document.querySelector<HTMLParagraphElement>('#access-error');

  if (accessForm && accessScreen && accessError) {
    accessForm.addEventListener('submit', (event) => {
      event.preventDefault();

      const formData = new FormData(accessForm);
      const username = formData.get('username');
      const password = formData.get('password');

      if (username === 'cristais' && password === 'jeri2026') {
        accessScreen.remove();
        sessionStorage.setItem('cristais-preview-access', 'true');
        return;
      }

      accessError.hidden = false;
    });

    if (sessionStorage.getItem('cristais-preview-access') === 'true') {
      accessScreen.remove();
    }
  }
</script>
<script>
  const siteNav = document.querySelector('#site-nav');

  function updateNavBackground() {
    siteNav?.classList.toggle('is-scrolled', window.scrollY > 40);
  }

  window.addEventListener('scroll', updateNavBackground, {
    passive: true,
  });

  updateNavBackground();
</script>
