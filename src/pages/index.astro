---
import 'leaflet/dist/leaflet.css';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Cristais de Jeri — em breve, a melhor hospedagem em Jericoacoara."
    />
    <title>Cristais de Jeri</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Antonio:wght@300;400;500;600;700&family=Montserrat:wght@300;400;500;600&family=Square+Peg&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <div class="access-screen" id="access-screen">
      <form class="access-form" id="access-form">
        <h1>Cristais de Jeri</h1>
        <p>Site em desenvolvimento</p>

        <label for="access-username">Usuário</label>
        <input
          id="access-username"
          name="username"
          type="text"
          autocomplete="username"
          required
        />

        <label for="access-password">Senha</label>
        <input
          id="access-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />

        <p class="access-error" id="access-error" hidden>
          Usuário ou senha incorretos.
        </p>

        <button type="submit">Entrar</button>
      </form>
    </div>
    <header class="site-nav" id="site-nav">
      <nav class="site-nav__inner" aria-label="Navegação principal">
        <a
          class="site-nav__logo"
          href="#inicio"
          aria-label="Cristais de Jeri — início"
        >
          <img
            src="/images/logo-horizontal-branco.png"
            alt="Cristais de Jeri"
          />
        </a>

        <div class="site-nav__links">
          <a href="#bangalos">Bangalôs</a>
          <a href="#localizacao">Localização</a>
          <a href="#conceito">Conceito</a>
        </div>
      </nav>
    </header>
    <main class="hero" id="inicio">
      <video class="hero__video" autoplay muted loop playsinline>
        <source src="/videos/video-bangalo-1080p.mp4" type="video/mp4" />
      </video>

      <div class="hero__overlay"></div>
      <div class="hero__content">
        <p class="hero__kicker">EcoVillage · Jericoacoara — CE</p>

        <h1>
          CRISTAIS
          <span>DE JERI</span>
        </h1>

        <p class="hero__description">
          Hotel com charmosos bangalôs ecológicos, integrados a natureza, para
          você curtir as maravilhas incríveis e emocionantes de Jericoacoara,
          mas também ter aquele momento só seu, em paz consigo e com o planeta.
        </p>

        <div class="hero__actions">
          <a href="#bangalos" class="hero__button hero__button--primary">
            Conhecer o bangalô
          </a>

          <a href="#localizacao" class="hero__button hero__button--ghost">
            Ver localização
          </a>
        </div>
      </div>
    </main>
    <section class="bangalos" id="bangalos">
      <div class="bangalos__header">
        <p class="bangalos__kicker">Os bangalôs</p>

        <h2>Seu espaço em Jeri</h2>

        <p class="bangalos__intro">
          Um bangalô ecológico que combina conforto, natureza e a essência de
          Jericoacoara.
        </p>
      </div>

      <div class="bangalo">
        <div class="bangalo__image">
          <img src="/images/safira-1.jpg" alt="Bangalô Safira" loading="lazy" />
        </div>

        <div class="bangalo__content">
          <span class="bangalo__badge"> O diferencial: hidro privativa </span>

          <h3>Bangalô Safira</h3>

          <ul>
            <li>Quarto espaçoso</li>
            <li>Banheiro</li>
            <li>Copa funcional</li>
            <li>Sala de estar acolhedora</li>
            <li>Varanda privativa com hidro e redário</li>
          </ul>

          <p class="bangalo__details">
            39 m² de área construída + 29 m² de terraço privativo com pergolado,
            redário e hidro.
          </p>

          <a href="#contato" class="bangalo__button">
            {' '}
            Entre em contato e saiba mais!{' '}
          </a>
        </div>
      </div>

      <!-- <div class="bangalo__gallery">
        <img src="/images/safira-2.jpg" alt="Bangalô Safira" loading="lazy" />

        <img
          src="/images/plantas.jpg"
          alt="Planta do Bangalô Safira"
          loading="lazy"
        />
      </div> -->
    </section>

    <section class="location" id="localizacao">
      <div class="location__container">
        <header class="location__header">
          <p class="location__kicker">Localização privilegiada</p>

          <h2>
            O paraíso do lado de fora
            <span>da sua varanda</span>
          </h2>

          <p class="location__description">
            Explore as belezas de Jericoacoara e descubra o que está a poucos
            minutos do Cristais de Jeri.
          </p>
        </header>

        <div class="location__content">
          <div class="location__list">
            <div class="location__featured">
              <span class="location__featured-icon" aria-hidden="true">
                ✈
              </span>

              <div>
                <p class="location__featured-label">Chegar é fácil</p>
                <h3>Aeroporto de Jericoacoara</h3>
                <p class="location__featured-distance">A apenas 10 minutos</p>
              </div>
            </div>

            <ol class="location__places">
              <li>
                <span class="location__number">01</span>
                <span class="location__place-name">Buraco Azul</span>
                <span class="location__distance">4,9 km</span>
              </li>

              <li>
                <span class="location__number">02</span>
                <span class="location__place-name">Lagun Beach Club</span>
                <span class="location__distance">7,7 km</span>
              </li>

              <li>
                <span class="location__number">03</span>
                <span class="location__place-name">Lagoa Azul</span>
                <span class="location__distance">7,7 km</span>
              </li>

              <li>
                <span class="location__number">04</span>
                <span class="location__place-name">Lagoa do Paraíso</span>
                <span class="location__distance">8,5 km</span>
              </li>

              <li>
                <span class="location__number">05</span>
                <span class="location__place-name">Praia do Preá</span>
                <span class="location__distance">10 km</span>
              </li>

              <li>
                <span class="location__number">06</span>
                <span class="location__place-name">Alchymist Beach Club</span>
                <span class="location__distance">Conferir rota</span>
              </li>

              <li>
                <span class="location__number">07</span>
                <span class="location__place-name">Pedra Furada</span>
                <span class="location__distance">Conferir rota</span>
              </li>

              <li>
                <span class="location__number">08</span>
                <span class="location__place-name">Vila de Jericoacoara</span>
                <span class="location__distance">Conferir rota</span>
              </li>
            </ol>
          </div>

          <div class="location__map-shell">
            <div
              id="jeri-map"
              class="location__map"
              role="application"
              aria-label="Mapa interativo do Cristais de Jeri e dos pontos turísticos próximos"
            ></div>

            <div
              id="jeri-popup-overlay"
              class="location__popup-overlay"
              hidden
            ></div>
          </div>
        </div>
      </div>
    </section>
    <section class="concept" id="conceito">
      <div class="concept__container">
        <div class="concept__intro">
          <div class="concept__text">
            <p class="concept__kicker">O conceito</p>

            <h2>
              Um EcoVillage
              <span>à beira de Jeri</span>
            </h2>

            <p class="concept__description">
              O EcoVillage é uma tendência nos principais destinos turísticos do
              mundo. Em 23 mil m² a poucos minutos dos principais pontos de
              Jericoacoara, o Cristais de Jeri reúne bangalôs ecológicos,
              infraestrutura de hotelaria e a natureza preservada do litoral
              oeste do Ceará — uma expressão concreta de ecoturismo.
            </p>
          </div>

          <div class="concept__image">
            <img
              src="/images/terreno.jpg"
              alt="Vista aérea do Cristais de Jeri"
              loading="lazy"
            />
          </div>
        </div>

        <div class="concept__stats">
          <div class="concept__stat">
            <strong>23 mil</strong>
            <span>m² de terreno</span>
          </div>

          <div class="concept__stat">
            <strong>36</strong>
            <span>unidades · 1ª etapa</span>
          </div>

          <div class="concept__stat">
            <strong>10 min</strong>
            <span>do aeroporto de Jeri</span>
          </div>
        </div>

        <div class="concept__sustainable">
          <div class="concept__sustainable-title">
            <p class="concept__kicker">Construído com a natureza</p>

            <h3>
              Um projeto pensado para
              <span>preservar o que importa.</span>
            </h3>
          </div>

          <div class="concept__principles">
            <div class="concept__principle">
              <span>◆</span>
              <p>Mão de obra e matéria-prima locais</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Preservação da mata nativa e seus arredores</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Passarelas suspensas para proteger espécies nativas</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Energia solar e reaproveitamento de água tratada</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Máxima permeabilidade do solo</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Prioridade à luz natural e ao conforto térmico</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Agricultura orgânica — jardim e pomar funcionais</p>
            </div>

            <div class="concept__principle">
              <span>◆</span>
              <p>Baixo custo de manutenção</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-height: 100%;
  }

  :global(body) {
    font-family: 'Montserrat', sans-serif;
  }

  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #142a63;
    color: #f4ede1;
  }

  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .hero__header {
    position: absolute;
    top: 2rem;
    left: 2rem;
    z-index: 2;
  }

  .hero__header img {
    display: block;
    width: 180px;
    height: auto;
  }

  .hero__content {
    position: absolute;
    left: 2rem;
    bottom: 3rem;
    z-index: 2;
    max-width: 620px;
  }

  .hero__kicker {
    margin: 0 0 1.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .hero__content h1 {
    margin: 0;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
  }

  .hero__content h1 span {
    display: block;
    color: #71d3c2;
  }

  .hero__description {
    max-width: 520px;
    margin: 1.75rem 0 0;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.65;
  }

  .hero__actions {
    display: flex;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0.75rem 1.7rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .hero__button--primary {
    background: #71d3c2;
    color: #142a63;
  }

  .hero__button--primary:hover {
    background: #eee96e;
    transform: translateY(-2px);
  }

  .hero__button--ghost {
    border: 1.5px solid #f4ede1;
    color: #f4ede1;
  }

  .hero__button--ghost:hover {
    background: #f4ede1;
    color: #142a63;
  }

  /* Classes Bangalos */

  .bangalos {
    padding: 6rem 2rem;
    background: #f4ede1;
    color: #142a63;
  }

  .bangalos__header {
    max-width: 720px;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .bangalos__kicker {
    margin: 0 0 0.75rem;
    color: #71d3c2;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .bangalos__header h2 {
    margin: 0 0 1rem;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 400;
    text-transform: uppercase;
  }

  .bangalos__intro {
    max-width: 55ch;
    margin: 0 auto;
    color: rgba(20, 42, 99, 0.7);
    font-size: 1rem;
    font-weight: 300;
    line-height: 1.7;
  }

  .bangalo {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
    gap: 4rem;
    align-items: center;
  }

  .bangalo__image {
    overflow: hidden;
    border-radius: 1.5rem;
    box-shadow: 0 20px 50px rgba(20, 42, 99, 0.12);
  }

  .bangalo__image img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .bangalo__badge {
    display: inline-block;
    margin-bottom: 1rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    background: #71d3c2;
    color: white;
    font-size: 0.7rem;
    font-weight: 600;
  }

  .bangalo__content h3 {
    margin: 0 0 1.25rem;
    color: #142a63;
    font-family: 'Square Peg', cursive;
    font-size: clamp(3.5rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 0.9;
  }

  .bangalo__content ul {
    display: grid;
    gap: 0.7rem;
    margin: 0 0 1.5rem;
    padding: 0;
    list-style: none;
  }

  .bangalo__content li {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9rem;
  }

  .bangalo__content li::before {
    content: '◆';
    flex-shrink: 0;
    color: #71d3c2;
    font-size: 0.55rem;
    margin-top: 0.35rem;
  }

  .bangalo__details {
    margin: 0;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(20, 42, 99, 0.15);
    color: rgba(20, 42, 99, 0.65);
    font-size: 0.8rem;
    line-height: 1.6;
  }

  .bangalo__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    margin-top: 1.75rem;
    padding: 0.75rem 1.6rem;
    border-radius: 999px;
    background: #142a63;
    color: #f4ede1;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }

  .bangalo__button:hover {
    background: #204295;
    transform: translateY(-2px);
  }

  .bangalo__gallery {
    max-width: 1180px;
    margin: 4rem auto 0;
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 1.5rem;
    align-items: center;
  }

  .bangalo__gallery img {
    display: block;
    width: 100%;
    border-radius: 1.25rem;
  }

  .concept {
    padding: 6rem 2rem;
    background: #f4ede1;
    color: #142a63;
  }

  .concept__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .concept__intro {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  .concept__kicker {
    margin: 0 0 1rem;
    color: #71d3c2;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .concept__text h2 {
    margin: 0;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .concept__text h2 span {
    display: block;
    color: #204295;
  }

  .concept__description {
    max-width: 560px;
    margin: 2rem 0 0;
    color: rgba(20, 42, 99, 0.72);
    font-size: 0.95rem;
    line-height: 1.75;
  }

  .concept__image {
    overflow: hidden;
    border-radius: 2rem;
  }

  .concept__image img {
    display: block;
    width: 100%;
    height: auto;
  }

  .concept__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 6rem 0;
    border-top: 1px solid rgba(20, 42, 99, 0.15);
    border-bottom: 1px solid rgba(20, 42, 99, 0.15);
  }

  .concept__stat {
    padding: 2.5rem 2rem;
    text-align: center;
  }

  .concept__stat + .concept__stat {
    border-left: 1px solid rgba(20, 42, 99, 0.15);
  }

  .concept__stat strong {
    display: block;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 400;
    line-height: 1;
  }

  .concept__stat span {
    display: block;
    margin-top: 0.6rem;
    color: rgba(20, 42, 99, 0.65);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .concept__sustainable {
    display: grid;
    grid-template-columns: minmax(260px, 0.8fr) 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }

  .concept__sustainable-title h3 {
    margin: 0;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(2rem, 3.5vw, 3.2rem);
    font-weight: 400;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .concept__sustainable-title h3 span {
    display: block;
    color: #204295;
  }

  .concept__principles {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem 2rem;
  }

  .concept__principle {
    display: flex;
    gap: 0.8rem;
    align-items: flex-start;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(20, 42, 99, 0.12);
  }

  .concept__principle span {
    flex-shrink: 0;
    color: #71d3c2;
    font-size: 0.65rem;
    margin-top: 0.35rem;
  }

  .concept__principle p {
    margin: 0;
    color: rgba(20, 42, 99, 0.78);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .location {
    padding: 3rem 2rem;
    background: #142a63;
    color: #f4ede1;
  }

  .location__container {
    max-width: 1440px;
    margin: 0 auto;
  }

  .location__header {
    max-width: 760px;
    margin: 0 auto 1.75rem;
    text-align: center;
  }

  .location__kicker {
    margin: 0 0 1rem;
    color: #71d3c2;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .location__header h2 {
    margin: 0;
    font-family: 'Antonio', sans-serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .location__header h2 span {
    display: block;
    color: #71d3c2;
  }

  .location__description {
    margin: 1.25rem 0 0;
    color: rgba(244, 237, 225, 0.75);
    font-size: 0.9rem;
    line-height: 1.7;
  }

  .location__content {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 7fr);
    gap: 2rem;
    align-items: stretch;
  }

  .location__list {
    min-width: 0;
  }

  .location__featured {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding: 1.25rem;
    border: 1px solid rgba(113, 211, 194, 0.35);
    border-radius: 1rem;
    background: rgba(32, 66, 149, 0.45);
  }

  .location__featured-icon {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #71d3c2;
    color: #142a63;
    font-size: 1.35rem;
  }

  .location__featured-label {
    margin: 0 0 0.35rem;
    color: #71d3c2;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .location__featured h3 {
    margin: 0;
    font-family: 'Antonio', sans-serif;
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .location__featured-distance {
    margin: 0.45rem 0 0;
    color: #71d3c2;
    font-size: 0.75rem;
  }

  .location__places {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .location__places li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 1rem 0;
