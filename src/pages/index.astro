  @keyframes jeri-marker-pulse {
    0% {
      opacity: 0.9;
      transform: scale(0.7);
    }

    100% {
      opacity: 0;
      transform: scale(1.7);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.jeri-marker__main::before) {
      animation: none;
    }
  }

  :global(.jeri-popup) {
    width: 240px;
    overflow: hidden;
    border-radius: 12px;
